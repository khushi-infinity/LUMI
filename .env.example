# ── AWS (the learning engine's spine) ─────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock — central AI layer (tutoring, reasoning, quizzes, notes, vision)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Storage & state — leave empty to run in demo mode (in-memory)
DYNAMODB_TABLE_NAME=lumi-student-state
S3_BUCKET_NAME=lumi-learning-material

# Auth (optional; demo mode works without it)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Voice (Sarvam) — Indian-language STT/TTS ──────────────────────
# Without a key, LUMI falls back to the Browser Speech API.
SARVAM_API_KEY=

# ── Digital human (Beyond Presence + LiveKit) ────────────────────
# Without these, the Live Tutor page shows the 2D mascot + browser voice.
BEY_API_KEY=
BEY_AVATAR_ID=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
